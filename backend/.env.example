# Backend environment variables.
# These are read from the process environment (os.environ), not auto-loaded from
# a file. Export them in your shell before starting, or use your IDE/runner's
# env-file support. This file documents the names + a runnable default.

# REQUIRED signing key for JWTs. Generate one yourself and never commit it:
#   py -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

DATABASE_URL=sqlite:///./helpdesk.db
ACCESS_TOKEN_EXPIRE_HOURS=24
FRONTEND_ORIGIN=http://localhost:5173
